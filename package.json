{
  "name": "fnaf-fan-game-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "data:pull": "node scripts/pull-data.mjs",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "assets": "node scripts/gen-placeholders.mjs",
    "gamejolt:helper": "node scripts/gamejolt/helper.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "test:gamejolt": "node --test scripts/gamejolt/test.mjs extension/capture.test.mjs",
    "selftest": "esbuild scripts/selftest.mts --bundle --platform=node --format=esm --external:vue --outfile=.tmp/selftest.mjs --log-level=warning && node .tmp/selftest.mjs",
    "smoke": "vite build --config vite.smoke.config.ts --logLevel warn && node .tmp/smoke-build/smoke.js",
    "test:ui": "node scripts/ui-test.mjs",
    "verify": "npm run typecheck && npm run test:gamejolt && npm run build:extension && npm run selftest && npm run smoke && npm run build",
    "preview": "vite preview",
    "test:extension": "npm run build:extension && node scripts/extension-test.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.25.12",
    "@esbuild/win32-x64": "0.25.12",
    "@rollup/rollup-linux-x64-gnu": "4.63.5",
    "@rollup/rollup-win32-x64-msvc": "4.63.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.64.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
